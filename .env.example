# OpenProject MCP — remote HTTP deploy. Copy thành `.env` rồi điền. KHÔNG commit `.env`.

# --- Bắt buộc ---
# URL OpenProject (MCP gọi qua public HTTPS).
OPENPROJECT_URL=https://openproject.example.com
# URL công khai HTTPS của chính MCP server (issuer/resource OAuth). Phải khớp domain reverse proxy.
MCP_PUBLIC_URL=https://mcp.example.com
# Host hợp lệ (chống DNS-rebinding) — domain công khai mà reverse proxy forward.
ALLOWED_HOSTS=mcp.example.com

# --- Khuyến nghị ---
# Origin trình duyệt được phép (Claude.ai web). Để trống nếu chỉ gọi server-to-server.
ALLOWED_ORIGINS=https://claude.ai
OPENPROJECT_TIMEOUT_SECONDS=15

# --- Auth ---
# Multi-user OAuth (khuyến nghị): ĐỪNG đặt OPENPROJECT_API_KEY — mỗi user tự đăng nhập OpenProject.
# Đơn-user (mọi request dùng chung 1 key, KHÔNG khuyến nghị cho remote):
# OPENPROJECT_API_KEY=your-personal-api-token

# --- Tùy chọn ---
# Bật nhóm tool destructive trên remote (mặc định tắt: ẩn delete/bulk/archive...).
# OP_MCP_ENABLE_ADMIN_DESTRUCTIVE=true
# Ghi đè bind (mặc định đã hợp cho Docker):
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
