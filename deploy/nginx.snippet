# nginx — TLS termination + reverse proxy tới container MCP (127.0.0.1:8000).
# Cần cert sẵn (vd certbot). Host forward phải khớp ALLOWED_HOSTS của MCP.
server {
    listen 443 ssl;
    http2 on;
    server_name mcp.example.com;

    ssl_certificate     /etc/letsencrypt/live/mcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;                      # → ALLOWED_HOSTS
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streamable HTTP (SSE): tắt buffer, giữ kết nối lâu.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# (Tùy chọn defense-in-depth) Chỉ cho dải IP Anthropic — IP có thể đổi, ĐỪNG coi là biện pháp duy nhất:
#   allow 1.2.3.0/24;  deny all;   # đặt trong location, cập nhật theo tài liệu Anthropic.
